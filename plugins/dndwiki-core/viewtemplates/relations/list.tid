title: $:/plugins/dndwiki-core/viewtemplates/relations/list
type: text/vnd.tiddlywiki

<!-- Iteriert ueber alle Feld-EdgeTypes und zeigt je Beziehung EINE Gruppe (Vorwaerts
     eigene Felder UNION Rueckwaerts wer-zeigt-hierher) unter dem Edge-Label aus der
     EdgeType-Config (getindex[label]). Label aendern = Graph + Liste zugleich. `self`
     kommt von der aufrufenden relations.tid. Rueckwaerts ueber den indizierten Operator
     `listed` statt einer Suche ueber alle Tiddler; die Treffer stehen einmal in der
     mehrwertigen Variable `treffer` und werden fuer Ueberschrift und Liste genutzt. -->

<$list filter="[all[shadows+tiddlers]prefix[$:/config/flibbles/graph/edges/fields/]removeprefix[$:/config/flibbles/graph/edges/fields/]] -[[tags]] -[[list]] +[sort[]]" variable=field>
<$let cfg={{{ [[$:/config/flibbles/graph/edges/fields/]addsuffix<field>] }}}
	treffer={{{ [<self>listed<field>!is[system]] =[<self>get<field>enlist-input[]] +[!match<self>unique[]sort[title]] }}}>
<%if [(treffer)] %>
<h3 style="text-transform:capitalize;"><$text text={{{ [<cfg>getindex[label]] :else[<field>] }}}/></h3>
<$list filter="[(treffer)]">
<div class="tc-menu-list-subitem"><<totlink title={{!!title}} style="~~">></div>
</$list>
<%endif%>
</$let>
</$list>
