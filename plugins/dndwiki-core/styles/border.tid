<!-- Rahmen in der Farbe des Typs: je Typ-Hub der Formatschicht (Tag Index, Feld color) eine
     Regel. all[shadows] beschraenkt auf die Typen aus dem Plugin - Inhalts-Tiddler mit eigenem
     color (Fraktions-/Ortstags der Kampagnen) bekommen keinen Rahmen. -->
<$list filter="[all[shadows]] :filter[tag[Index]has[color]] +[sort[]]">
.tc-tagged-<$text text={{{ [<currentTiddler>encodeuricomponent[]escapecss[]] }}}/> {
border: 2px solid <$text text={{!!color}}/>;
}
</$list>
